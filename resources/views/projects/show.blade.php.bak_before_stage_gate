<script>
function toggleProjectPrivacy(projectId) {
    if (!confirm('Projenin gizlilik seviyesini de?i?tirmek istedi?inize emin misiniz?')) return;
    
    fetch(`/projects/${projectId}/toggle-visibility`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
            'Accept': 'application/json'
        }
    })
    .then(r => r.json())
    .then(res => {
        if (res.success) {
            const badge = document.getElementById('projectPrivacyBadge');
            const icon = document.getElementById('projectPrivacyIcon');
            const text = document.getElementById('projectPrivacyText');
            if (res.visibility === 'private') {
                if (badge) {
                    badge.style.background = '#fef2f2';
                    badge.style.color = '#991b1b';
                    badge.style.borderColor = '#fecaca';
                }
                if (icon) icon.textContent = '??';
                if (text) text.textContent = '?zel / Gizli Proje';
            } else {
                if (badge) {
                    badge.style.background = '#e0f2fe';
                    badge.style.color = '#0369a1';
                    badge.style.borderColor = '#bae6fd';
                }
                if (icon) icon.textContent = '??';
                if (text) text.textContent = 'Genel Proje';
            }
            alert(res.message);
        } else {
            alert(res.message || 'Gizlilik de?i?tirilemedi.');
        }
    })
    .catch(err => {
        alert('Sunucu hatas?: ' + err.message);
    });
}
</script>
