                        <!-- 2. Fazlar ve Görevler -->
                        @foreach($project->phases as $ph)
                            <!-- Faz Satırı -->
                            <div class="gantt-table-row gantt-row-item phase-row" style="height: 48px; background: #f8fafc; font-weight: 700;">
                                <div class="gantt-col-task" style="font-size: 12.5px; color: #0369a1; padding-left: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ $ph->name }}">
                                    🔷 {{ Str::limit($ph->name, 22) }}
                                </div>
                                <div class="gantt-col-assignee" style="font-size: 11px; color: #64748b;">
                                    {{ $ph->tasks->count() }} Görev
                                </div>
                                <div class="gantt-col-progress" style="text-align: center;">
                                    <span class="badge" style="background: {{ round($ph->progress_percentage) == 100 ? '#ecfdf5; color: #065f46;' : '#f1f5f9; color: #475569;' }}; font-size: 10.5px; font-weight: 800; padding: 2px 6px; border-radius: 4px;">
                                        %{{ (int) round($ph->progress_percentage) }}
                                    </span>
