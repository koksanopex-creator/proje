<script>

function toggleAssigneeDropdown(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('assigneeDropdownMenu');
    const trigger = document.getElementById('assigneeSelectTrigger');
    if (!menu) return;
    const isShowing = menu.style.display === 'flex';
    menu.style.display = isShowing ? 'none' : 'flex';
    if (!isShowing) {
        trigger.style.borderColor = '#0284c7';
        trigger.style.boxShadow = '0 0 0 3px rgba(2, 132, 199, 0.15)';
        const search = document.getElementById('assigneeSearchInput');
        if (search) {
            search.value = '';
            filterAssigneeList();
            setTimeout(() => search.focus(), 50);
        }
    } else {
        trigger.style.borderColor = '#cbd5e1';
        trigger.style.boxShadow = 'none';
    }
}

function filterAssigneeList() {
    const q = (document.getElementById('assigneeSearchInput')?.value || '').toLowerCase().trim();
    document.querySelectorAll('.assignee-item-row').forEach(row => {
        const text = row.getAttribute('data-name') || '';
        row.style.display = (q === '' || text.includes(q)) ? 'flex' : 'none';
    });
}

function updateAssigneeSummary() {
    const checkedBoxes = Array.from(document.querySelectorAll('#assigneeItemsList input[type="checkbox"]:checked'));
    const summary = document.getElementById('assigneeTriggerSummary');
    const chipsContainer = document.getElementById('assigneeSelectedChips');

    if (!summary || !chipsContainer) return;

    if (checkedBoxes.length === 0) {
        summary.innerHTML = '<span>👥</span> <span>Personel Seçiniz (Çoklu)...</span>';
        summary.style.color = '#64748b';
        chipsContainer.innerHTML = '';
        return;
    }

    const names = checkedBoxes.map(cb => cb.getAttribute('data-username'));
    summary.innerHTML = '<span>👥</span> <strong style="color: #0284c7;">' + checkedBoxes.length + ' Personel:</strong> <span style="color: #334155;">' + names.slice(0, 2).join(', ') + (names.length > 2 ? '...' : '') + '</span>';
    summary.style.color = '#0284c7';

    // Chips
    chipsContainer.innerHTML = '';
    checkedBoxes.forEach(cb => {
        const uId = cb.value;
        const uName = cb.getAttribute('data-username');
        const pill = document.createElement('span');
        pill.style.cssText = 'background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 5px;';
        pill.innerHTML = '<span>' + uName + '</span><button type="button" onclick="removeAssigneeSelection(\'' + uId + '\', event)" style="border: none; background: none; color: #0284c7; cursor: pointer; padding: 0; font-size: 12px; font-weight: 800; line-height: 1;">✕</button>';
        chipsContainer.appendChild(pill);
    });
}

function removeAssigneeSelection(userId, e) {
    if (e) e.stopPropagation();
    const cb = document.querySelector('#assigneeItemsList input[type="checkbox"][value="' + userId + '"]');
    if (cb) {
        cb.checked = false;
        updateAssigneeSummary();
    }
}

function clearAllAssignees() {
    document.querySelectorAll('#assigneeItemsList input[type="checkbox"]').forEach(cb => cb.checked = false);
    updateAssigneeSummary();
}

document.addEventListener('click', function(e) {
    const trigger = document.getElementById('assigneeSelectTrigger');
    const menu = document.getElementById('assigneeDropdownMenu');
    if (menu && menu.style.display === 'flex' && trigger && !trigger.contains(e.target) && !menu.contains(e.target)) {
        menu.style.display = 'none';
        trigger.style.borderColor = '#cbd5e1';
        trigger.style.boxShadow = 'none';
    }
});


function openKanbanTaskModal(status = 'todo') {
    clearAllAssignees();
    const statusInput = document.getElementById('kanbanTaskStatus');
    if (statusInput) statusInput.value = status;
    const modal = document.getElementById('kanbanTaskModal');
    if (modal) modal.style.display = 'flex';
}

function closeKanbanTaskModal() {
    const modal = document.getElementById('kanbanTaskModal');
    if (modal) modal.style.display = 'none';
}
</script>
@endif
