    @push('scripts')
    <script>
        let draggedTaskId = null;

        function drag(ev, taskId) {
            draggedTaskId = taskId;
            ev.dataTransfer.setData("text", taskId);
        }

        function allowDrop(ev) {
            ev.preventDefault();
        }

        function drop(ev, targetStatus) {
            ev.preventDefault();
            if (!draggedTaskId) return;

            // AJAX ile durumu sunucuya bildir
            fetch("{{ route('kanban.update_status') }}", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-CSRF-TOKEN": "{{ csrf_token() }}"
                },
                body: JSON.stringify({
                    task_id: draggedTaskId,
                    status: targetStatus
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                }
            });
        }
    </script>
    @endpush
