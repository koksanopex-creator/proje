<style>
/* ==========================================================================
   MASAÜSTÜ SIDEBAR DARALTMA / GENİŞLETME (GEMINI STİLİ)
   ========================================================================== */
.app-sidebar {
    width: 270px;
    min-width: 270px;
    transition: margin-left 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.22s ease,
                visibility 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
    will-change: margin-left, opacity;
}

.app-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100vh;
    width: calc(100vw - 270px);
    transition: width 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                margin-left 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

/* Sidebar Gizlendiğinde (Collapsed) */
.app-layout.sidebar-collapsed .app-sidebar {
    margin-left: -270px !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
}

.app-layout.sidebar-collapsed .app-main {
    width: 100vw !important;
}

/* Sidebar Brand Header ve Collapse Butonu */
